# Copy to .env (never commit .env). No secrets here - placeholders only.
#
# Two DIFFERENT database roles on purpose:
#   MIGRATION_DATABASE_URL -> owner role (Supabase: "postgres"). Used ONLY by Alembic. Bypasses RLS.
#   DATABASE_URL           -> runtime role "ai_civ_app" (created by migration 0001, NOLOGIN until you enable it,
#                             see README). Subject to Row Level Security. The app refuses to start as the owner.
#
# Use the asyncpg driver. Plain "postgresql://" is accepted and rewritten to "postgresql+asyncpg://".
# For TLS use "?ssl=require" ("?sslmode=require" is accepted and rewritten to "ssl=require").
#
# Supabase connection types (checked against the Supabase docs):
#   direct          db.<ref>.supabase.co:5432                  (IPv6 unless the IPv4 add-on is enabled)  -> migrations
#   session pooler  <region>.pooler.supabase.com:5432          (IPv4)                                    -> long-running bot / Celery
#   transaction     <region>.pooler.supabase.com:6543          (IPv4, NO prepared statements)            -> DB_POOLER_MODE=transaction
# Through a pooler the user name is "<role>.<project-ref>", e.g. ai_civ_app.<project-ref>

# --- Default: the bundled `postgres` service of docker-compose.yml (host name = the compose service name, NOT localhost).
#     Owner = POSTGRES_USER / POSTGRES_PASSWORD (set them at the bottom of this file); ai_civ_app gets its password when you enable the role (README).
MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@postgres:5432/civ_db
DATABASE_URL=postgresql+asyncpg://ai_civ_app:CHANGE_ME@postgres:5432/civ_db
# --- Supabase instead (comment the two lines above, uncomment these):
# MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@db.PROJECT_REF.supabase.co:5432/postgres?ssl=require
# DATABASE_URL=postgresql+asyncpg://ai_civ_app:CHANGE_ME@REGION.pooler.supabase.com:5432/postgres?ssl=require
# --- Running WITHOUT docker (python -m ai_civ.bot on the host): use 127.0.0.1:<published port> for the database and Redis, and leave GEMINI_PROXY empty.

# direct | session | transaction
DB_POOLER_MODE=session
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_ECHO=false

# ---- Celery / Redis: inside docker compose the host is the service name `redis` (docker-compose.yml also pins these two for every app service,
# so a stale value here cannot break the stack). On the host without docker use redis://127.0.0.1:6379/0.
CELERY_BROKER_URL=redis://redis:6379/0
RATE_LIMIT_REDIS_URL=redis://redis:6379/0

# ---- Outbound proxy (docker-compose `proxy` service -> `warp`). Only Gemini and the Telegram Bot API use it; the database, Redis and the link
# summariser stay direct. socks5h = the proxy resolves host names. Empty value = direct connection (e.g. a server that can reach both without it).
GEMINI_PROXY=socks5h://proxy:1080
TELEGRAM_PROXY=socks5h://proxy:1080
# Where `proxy` forwards to. Default: the bundled `warp` container. WARP already running on the host: host.docker.internal / 40000.
# PROXY_UPSTREAM_HOST=warp
# PROXY_UPSTREAM_PORT=1080

# ---- Gemini (the only LLM vendor). The key is a secret: put it ONLY in your local .env.
GEMINI_API_KEY=CHANGE_ME
GEMINI_JUDGE_MODEL=gemini-3.5-flash-lite
GEMINI_GC_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=1536                 # must equal vector(N) of civ.episodic_memories
LLM_TIMEOUT_SECONDS=90
EMBED_TIMEOUT_SECONDS=30
GEMINI_CHAT_MODEL=gemini-3.8-flash         # answers users (Module 2)
GEMINI_ROUTER_MODEL=gemini-3.5-flash-lite  # decides whether a message in the main chat opens a new topic
GEMINI_ONBOARDING_MODEL=gemini-3.5-flash-lite  # parses one interview answer into strict JSON
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-flash-lite  # listens to a voice note and returns the words (audio-capable; the Ogg/Opus bytes go straight to Gemini)

# Voice notes: downloaded into memory, transcribed by Gemini (GEMINI_TRANSCRIBE_MODEL), only the TEXT is kept
VOICE_ENABLED=true                 # false = voice notes are answered with "write it as text"
VOICE_ECHO=false                   # true = a "Heard: ..." line before the reply (off: no chat noise; the transcript is stored either way)
VOICE_HEAR_TONE=true               # the recording itself also goes to the chat model, so it hears tone / crying / sarcasm, not only the words
VOICE_MAX_SECONDS=900              # 15 minutes; longer notes are refused before downloading
VOICE_MAX_BYTES=26214400           # 25 MB (the cloud Bot API itself serves files up to 20 MB)
VOICE_TRANSCRIPT_MAX_CHARS=25000   # a longer transcript is refused, never cut
VOICE_LLM_TIMEOUT_SECONDS=180      # deadline for downloading / transcribing / answering a voice note (instead of LLM_TIMEOUT_SECONDS)

# Rate limit: protects the Gemini budget. Redis, fixed window per Telegram user; over the limit the update is dropped (no model call)
# and the user gets "Превышен лимит запросов..." once per window. Fail-open: if Redis is down the messages pass (warning in the log).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MESSAGES=20             # per window per user; a voice note counts as one message
RATE_LIMIT_WINDOW_SECONDS=60
# RATE_LIMIT_REDIS_URL=redis://127.0.0.1:6379/0   # unset = CELERY_BROKER_URL
RATE_LIMIT_REDIS_TIMEOUT_SECONDS=1

# Autonomous topic renaming: the model may rename a topic whose subject has clearly changed (cooldowns live in the database)
TOPIC_RENAME_ENABLED=true
TOPIC_RENAME_COOLDOWN_HOURS=24         # after a rename (or the creation of the topic) by the bot
TOPIC_RENAME_USER_COOLDOWN_DAYS=7      # after the user renamed the topic by hand

# Check-ins: the bot writes first to a user who has been silent (tenant-local slots, never in quiet hours)
CHECKIN_ENABLED=true
CHECKIN_MORNING_FOLLOWUP_SECONDS=600   # first morning check-in unanswered for this long -> one insistent follow-up with the "I am up" button; 0 = off
# CHECKIN_SLOTS=10:30,14:00,17:30,20:00   # empty (default) = 3-4 RANDOM slots a day per user inside their active hours; set a list to pin fixed ones
CHECKIN_MIN_SLOTS=3
CHECKIN_MAX_SLOTS=4
CHECKIN_MIN_GAP_MINUTES=150
CHECKIN_EDGE_MINUTES=90
CHECKIN_MIN_SILENCE_HOURS=3
CHECKIN_MAX_UNANSWERED=2               # after this many unanswered check-ins the bot waits until the user writes

# Photos and documents (images / PDF go to Gemini inline, TXT / DOCX are read by the bot)
ATTACHMENTS_ENABLED=true
ATTACHMENT_MAX_BYTES=10000000          # checked on Telegram's metadata before downloading
ATTACHMENT_TEXT_MAX_CHARS=60000
ATTACHMENT_TEXT_FILE_MAX_BYTES=500000  # TXT / DOCX only: bigger -> "Файл слишком большой для поточного анализа. Ограничение — 500 КБ."
ATTACHMENT_TEXT_FILE_MAX_LINES=2000    # ... and so is a text with more lines (for big histories use: python -m ai_civ.cli.import_history)

# Instant memory: the model may save a lasting fact the user states about themselves (a card with a cancel button follows)
SAVE_FACT_ENABLED=true                 # false = the model is never offered save_fact (the nightly GC and its quarantine still work)
SAVE_FACT_MAX_CALLS=3                  # facts saved per message
SAVE_FACT_MAX_PER_DAY=40               # versions one user's chat may write in 24 h
SAVE_FACT_MIN_CHARS=8                  # a shorter message is not offered the function

# Diplomat: hard cap on the reply written about a contact (0 = no cap; thinking tokens count against it)
DIPLOMAT_MAX_OUTPUT_TOKENS=400

# ---- Userbot (Telethon): creates the person's private forum group on /start (a SECOND Telegram identity: a normal user account).
# api_id / api_hash: my.telegram.org -> API development tools. The session string is as secret as a password: whoever has it IS that account.
# Make it once with `python -m ai_civ.cli.userbot_login` (asks for the account's phone and the code). All three empty = the person creates the group by hand.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_USERBOT_SESSION=
# USERBOT_ENABLED=true             # false = ignore the credentials above
# USERBOT_MAX_GROUPS_PER_DAY=20    # Telegram flood-limits an account that creates groups in bulk; over the limit the person gets the manual instructions
# USERBOT_LINK_TTL_DAYS=7          # the one-use invite link for a person whose privacy settings forbid adding them

# ---- Telegram (Module 2). Long Polling: no public URL needed. The token is a secret: ONLY in your local .env.
# Create the bot in @BotFather; add it to your forum supergroup as an ADMIN with the "Manage topics" right.
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_REQUEST_TIMEOUT=30        # seconds per Bot API request
TELEGRAM_NETWORK_RETRIES=2         # repeats of a Bot API call that failed on the network (proxy blip); 0 = none
TELEGRAM_NETWORK_RETRY_PAUSE=1.0   # seconds, multiplied by the attempt number
TELEGRAM_POLLING_TIMEOUT=10        # seconds of one long poll

# ---- Automatic registration (Module 5): add the bot to a forum group as admin, and the owner is registered.
REGISTRATION_RETRY_SECONDS=30      # one group is re-checked from plain messages at most this often (per sender)
REGISTRATION_HINT_SECONDS=600      # ... and told "what is still missing" at most this often (per group)

# ---- Contacts (Module 5): one-time invite links and the notification outbox (all have defaults)
INVITE_TTL_HOURS=72                # an invite link works this long, and only once
NOTIFICATION_BATCH_PER_RUN=20      # notifications one worker run delivers per tenant
NOTIFICATION_DISPATCH_LIMIT=500    # tenants handed to the queue by one Beat tick (every minute)
NOTIFICATION_MAX_AGE_DAYS=30       # an undeliverable notification is given up after this long

# ---- Mini App (Module 4). Direct Link: https://t.me/<TELEGRAM_BOT_USERNAME>/<MINI_APP_SHORT_NAME>
# The public HTTPS URL of the page is NOT here: it is set in @BotFather (/myapps -> your app -> Edit Web App URL) to your tunnel.
TELEGRAM_BOT_USERNAME=PerfectPerson_bot
MINI_APP_SHORT_NAME=Overview
WEB_HOST=127.0.0.1                 # ai_civ.web listens here; the tunnel (cloudflared / ngrok) forwards to it
WEB_PORT=8080
# WEB_DIST_DIR=                    # the Svelte build (npm run build in web/); default: <project>/web/dist
INIT_DATA_MAX_AGE_SECONDS=86400    # how long the signed launch data of an opened Mini App is accepted

# ---- Prompt assembly
CONTEXT_HOURS=72                   # Context Buffer window
CONTEXT_MAX_MESSAGES=60            # newest messages of the topic inside the window
CONTEXT_MAX_CHARS=24000            # oldest turns are dropped first when the buffer exceeds this
PROMPT_MAX_CORE_FACTS=150

# ---- Tier 2 in replies (episodic memory + LLM-Judge; JUDGE_TOP_K candidates, GEMINI_JUDGE_MODEL decides)
RECALL_ENABLED=true                # false = the bot answers from Tier 1 + Tier 3 only
RECALL_MIN_QUERY_CHARS=12          # shorter messages skip the lookup
RECALL_QUERY_MAX_CHARS=2000
RECALL_MAX_CHARS=4000              # budget of the "Episodic memory" section of the prompt
RECALL_TIMEOUT_SECONDS=20          # one deadline for embed + search + Judge; on failure the bot answers without memory
# RECALL_MAX_DISTANCE=0.6          # cosine distance cut-off before the Judge; off until calibrated on real data

# ---- The Diplomat (a contact's avatar may be asked for what that contact allowed; every ask is audited in the database)
DIPLOMAT_ENABLED=true              # false = the bot never offers the ask-a-contact tool to the model
DIPLOMAT_MAX_CALLS=3               # asks honoured per message
DIPLOMAT_MAX_CONTACTS=40           # contacts shown to the model per message
DIPLOMAT_TIMEOUT_SECONDS=15        # one ask

# Events from conversation (Module 5, step 5)
QUICK_EVENTS_ENABLED=true          # false = the model is never offered create_event (works for users without contacts too)
QUICK_EVENTS_MAX_CALLS=3           # drafts made per message
QUICK_EVENTS_MAX_PENDING=10        # open drafts per user
QUICK_EVENTS_TTL_HOURS=24          # an unanswered card goes stale after this
EVENT_DRAFT_PURGE_DAYS=7           # decided / expired drafts are deleted this long after
EVENT_PROPOSAL_PURGE_DAYS=30       # decided / expired invitations are deleted this long after

# ---- Stage 5 (PR 5.1 - 5.4)
ERROR_REPORTS_ENABLED=true            # crash_log_<time>.txt with the traceback goes to the admin below on an unhandled error (bot, Celery, userbot)
ERROR_REPORT_COOLDOWN_SECONDS=300     # the same error from the same place is sent once per this time
FEEDBACK_ADMIN_TELEGRAM_ID=413277509  # messages written in the "Ideas and feedback" topic are forwarded here (the author must have started the bot)
FEEDBACK_MAX_CHARS=3500
SAVE_FACT_CARD_TTL_SECONDS=15       # the "📝 Запомнил" card deletes itself after this long unless "Отменить" was pressed ("✅ ОК" deletes it at once); 0 = it stays
CREATE_TOPIC_MAX_ACTIVE=5           # the bot's own topics (Settings and feedback excluded); at the cap no new topic is made
CREATE_TOPIC_COOLDOWN_HOURS=24     # at most one new topic per this many hours
ROUTER_MIN_CONFIDENCE=0.85         # the General router opens a NEW topic only at this confidence
ROUTER_MIN_CONFIDENCE_EXISTING=0.6 # ... and moves a message into an existing topic from this one
CREATE_TOPIC_REQUIRE_OFFER=true    # create_topic only after the bot offered a topic and the user agreed (or asked for one); false = the old behaviour
DELETE_TOPIC_ENABLED=true          # the model may ASK to delete a topic; only the user's button deletes it
XP_DECAY_ENABLED=true              # nightly penalties: no workout for more than XP_DECAY_BODY_IDLE_DAYS -> -10 body; a task 48 h overdue -> -10 focus
XP_DECAY_LOCAL_HOUR=3
XP_DECAY_BODY_IDLE_DAYS=5
XP_DECAY_TASK_OVERDUE_HOURS=48
XP_DECAY_AMOUNT=10
XP_DECAY_MAX_TASK_PENALTIES=5      # per user per night
REMINDERS_ENABLED=true             # schedule_reminder: reminders, wake-up alarms and pings through Celery countdown tasks (state in Redis)
REMINDERS_MAX_DELAY_SECONDS=86400
REMINDERS_MAX_PENDING=10
REMINDERS_REPEAT_MIN_SECONDS=120   # an unanswered alarm repeats every 2-3 minutes ...
REMINDERS_REPEAT_MAX_SECONDS=180
REMINDERS_MAX_REPEATS=5            # ... at most this many times
# REMINDERS_REDIS_URL=             # default: the Celery broker

# ---- Outbox / Garbage Collector
GC_LOCAL_HOUR=3                    # tenant-local hour after which "yesterday" is compressed
OUTBOX_LEASE_SECONDS=900           # must exceed CELERY_TASK_TIME_LIMIT (870)
OUTBOX_DONE_TTL_DAYS=7

# ---- Proactivity and the weekly review of the quarantine (Module 3)
PROACTIVE_GRACE_MINUTES=30         # a scheduled nudge later than this after its time is skipped for that day
REVIEW_LOCAL_WEEKDAY=6             # tenant-local weekday of the review, Monday=0 (6 = Sunday)
REVIEW_LOCAL_HOUR=18
REVIEW_MAX_ITEMS=8
REVIEW_EXPIRE_DAYS=28
REVIEW_COOLDOWN_DAYS=30

# ---- Docker Compose (docker-compose.yml). Only for the bundled `postgres` service; with Supabase it still needs a value to start.
# To use the bundled DB point DATABASE_URL / MIGRATION_DATABASE_URL at host `postgres` (user = POSTGRES_USER for migrations).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=civ_db
# CELERY_CONCURRENCY=2

# Daily mood chart (bot/mood.py): a cheap model reads one local day of the user's own messages every 3 hours and writes a score -2..+2 (only the owner sees it)
MOOD_ENABLED=true
GEMINI_MOOD_MODEL=gemini-3.5-flash-lite
MOOD_MIN_MESSAGES=3                # a day with fewer of the user's own messages is not judged (a gap on the chart)
MOOD_MAX_MESSAGES=60
MOOD_MAX_CHARS=9000

# A wake-up ALARM repeats every REMINDERS_ALARM_REPEAT_SECONDS until it is acknowledged, at most REMINDERS_ALARM_MAX_REPEATS times
REMINDERS_ALARM_REPEAT_SECONDS=180
REMINDERS_ALARM_MAX_REPEATS=60            # 60 x 180 s = 3 hours of pings, until the user answers
# Voice mode: the REPEATS of an alarm are sent as a short voice note (the phone sounds its priority tone). The sound is a file YOU provide
# (OGG/Opus, MP3 or M4A, a few seconds): the project has no encoder / TTS. No file, or Telegram refuses it -> an ordinary text message.
REMINDERS_VOICE_PING=false
# REMINDERS_VOICE_FILE=/app/assets/alarm.ogg

# Mobile app API (/api/v1/mobile). Unset = the routers are not mounted (a warning is logged); the Mini App and the bot work as before.
# APP_JWT_SECRET=                          # >= 32 characters: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_ACCESS_TTL_MINUTES=15
APP_REFRESH_TTL_DAYS=30
APP_REFRESH_GRACE_SECONDS=10               # a just-rotated refresh token still works this long (parallel requests of one phone)
APP_AUTH_RATE_LIMIT_ATTEMPTS=8             # /login, /register: per (IP, e-mail) per window; Redis, fail-open (needs RATE_LIMIT_ENABLED=true)
APP_AUTH_RATE_LIMIT_IP_ATTEMPTS=40         # per IP whatever the e-mail
APP_AUTH_RATE_LIMIT_WINDOW_SECONDS=600
APP_TRUST_FORWARDED_FOR=false              # true ONLY behind a proxy that overwrites X-Forwarded-For
